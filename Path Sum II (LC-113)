
class Solution {
public:
   void solve(TreeNode* root, int targetSum,vector<vector<int>>&ans,vector<int>&p){
    if(root==nullptr) return;
   
    p.push_back(root->val);
    targetSum-=root->val;
    if(!root->left && !root->right && targetSum==0) ans.push_back(p);
    solve(root->left,targetSum,ans,p);
    solve(root->right,targetSum,ans,p);
     p.pop_back();
   }
    vector<vector<int>> pathSum(TreeNode* root, int targetSum) {
        vector<vector<int>> ans;
        if(!root) return ans;
        vector<int>p;
        solve(root,targetSum,ans,p);
        return ans;
    }
};
