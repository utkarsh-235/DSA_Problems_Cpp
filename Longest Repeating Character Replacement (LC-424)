class Solution {
public:
    int characterReplacement(string s, int k) {
        vector<int>freq(26,0);
        int l=0,ans=0,mf=0;
        for(int r=0;r<s.length();r++){
            freq[s[r]-'A']++;
            mf=max(mf,freq[s[r]-'A']);
            while((r-l+1)-mf>k) freq[s[l]-'A']--,l++;
            ans=max(ans,r-l+1);
        }
    return ans;}
};
